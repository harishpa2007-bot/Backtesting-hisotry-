<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  table { border-collapse: collapse; font-family: Calibri, sans-serif; font-size: 11pt; }
  th { background-color: #1f4e78; color: white; padding: 8px; border: 1px solid #ccc; text-align: left; }
  td { padding: 8px; border: 1px solid #ccc; }
  .profit { background-color: #d4edda; color: #155724; font-weight: bold; }
  .loss { background-color: #f8d7da; color: #721c24; font-weight: bold; }
</style>
</head>
<body>
<table>
  <tr>
    <th>Expiry Date</th><th>Execution Time</th><th>Symbol</th><th>Strike Price</th>
    <th>Entry Price (₹)</th><th>Closing Price (₹)</th><th>Quantity</th><th>Result</th><th>PnL Amount (₹)</th><th>Exit Reason</th>
  </tr>
  <tr>
    <td>2026-08-06</td><td>2026-08-06 15:15:00</td><td>NIFTY</td><td>25100 CE (ATM)</td>
    <td>113.96</td><td>123.62</td><td>65</td>
    <td class="profit">🟢 PROFIT (+₹627.90)</td><td class="profit">₹627.90</td><td>MARKET_CLOSE_TIME</td>
  </tr>
  <tr>
    <td>2026-08-06</td><td>2026-08-06 15:15:00</td><td>NIFTY</td><td>25100 PE (ATM)</td>
    <td>124.13</td><td>116.29</td><td>65</td>
    <td class="loss">🔴 LOSS (-₹509.60)</td><td class="loss">₹-509.60</td><td>MARKET_CLOSE_TIME</td>
  </tr>
</table>
</body>
</html>