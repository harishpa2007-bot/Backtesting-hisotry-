<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Calibri, sans-serif; font-size: 11pt; }
  table { border-collapse: collapse; width: 100%; margin-top: 10px; }
  th { background-color: #1f4e78; color: white; padding: 10px; border: 1px solid #b0c4de; text-align: center; font-size: 11pt; }
  td { padding: 8px 12px; border: 1px solid #d3d3d3; text-align: center; }
  tr:nth-child(even) { background-color: #f9f9f9; }
  .profit-bg { background-color: #d4edda !important; color: #155724 !important; font-weight: bold; }
  .loss-bg { background-color: #f8d7da !important; color: #721c24 !important; font-weight: bold; }
  .title { font-size: 16pt; font-weight: bold; color: #1f4e78; margin-bottom: 10px; }
</style>
</head>
<body>
<div class="title">📊 Expiry Hero or Zero Strategy Backtest Results</div>
<table>
  <thead>
    <tr>
      <th>Expiry Date</th>
      <th>Entry Time</th>
      <th>Meet / Exit Time</th>
      <th>Symbol</th>
      <th>Strike Price</th>
      <th>Entry Price (₹)</th>
      <th>Closing Price (₹)</th>
      <th>Quantity</th>
      <th>Result</th>
      <th>PnL Amount (₹)</th>
      <th>Exit Reason</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>2026-10-13</td>
      <td>2026-10-13 15:15:00</td>
      <td>2026-10-13 15:40:00</td>
      <td>NIFTY</td>
      <td>22750 CE (OTM1)</td>
      <td>₹6.00</td>
      <td>₹0.05</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹386.75)</td>
      <td class="loss-bg">-₹386.75</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
    <tr>
      <td>2026-10-13</td>
      <td>2026-10-13 15:15:00</td>
      <td>2026-10-13 15:40:00</td>
      <td>NIFTY</td>
      <td>22650 PE (OTM1)</td>
      <td>₹6.00</td>
      <td>₹0.05</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹386.75)</td>
      <td class="loss-bg">-₹386.75</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
  </tbody>
</table>
</body>
</html>