<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Calibri, sans-serif; font-size: 11pt; }
  table { border-collapse: collapse; width: 100%; margin-top: 10px; margin-bottom: 25px; }
  th { background-color: #1f4e78; color: white; padding: 10px; border: 1px solid #b0c4de; text-align: center; font-size: 11pt; font-weight: bold; }
  td { padding: 8px 12px; border: 1px solid #d3d3d3; text-align: center; font-size: 11pt; }
  tr:nth-child(even) { background-color: #f9f9f9; }
  .true-bg { background-color: #d4edda !important; color: #155724 !important; font-weight: bold; }
  .false-bg { background-color: #f8d7da !important; color: #721c24 !important; font-weight: bold; }
  .title { font-size: 16pt; font-weight: bold; color: #1f4e78; margin-bottom: 5px; }
  .section-title { font-size: 13pt; font-weight: bold; color: #1f4e78; margin-top: 20px; margin-bottom: 5px; }
</style>
</head>
<body>
<div class="title">📊 Comparative Expiry Hero-Zero Strategy Report</div>

<div class="section-title">1. Comparative Multi-Ratio Target Summary (ATM vs OTM vs ITM vs ALL)</div>
<table>
  <thead>
    <tr>
      <th>Configuration</th>
      <th>Trades</th>
      <th>Target 1:1</th>
      <th>Target 1:2</th>
      <th>Target 1:3</th>
      <th>Overall Attained</th>
      <th>Result</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="font-weight: bold; text-align: left;">ATM ONLY</td>
      <td>11</td>
      <td>7 / 11 (63.6%)</td>
      <td>3 / 11 (27.3%)</td>
      <td>3 / 11 (27.3%)</td>
      <td>7 / 11 (63.6%)</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td style="font-weight: bold; text-align: left;">OTM ONLY</td>
      <td>14</td>
      <td>9 / 14 (64.3%)</td>
      <td>6 / 14 (42.9%)</td>
      <td>4 / 14 (28.6%)</td>
      <td>9 / 14 (64.3%)</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td style="font-weight: bold; text-align: left;">ITM ONLY</td>
      <td>5</td>
      <td>4 / 5 (80.0%)</td>
      <td>2 / 5 (40.0%)</td>
      <td>2 / 5 (40.0%)</td>
      <td>4 / 5 (80.0%)</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td style="font-weight: bold; text-align: left;">ALL (ATM + OTM + ITM)</td>
      <td>15</td>
      <td>11 / 15 (73.3%)</td>
      <td>8 / 15 (53.3%)</td>
      <td>6 / 15 (40.0%)</td>
      <td>11 / 15 (73.3%)</td>
      <td class="true-bg">True</td>
    </tr>
  </tbody>
</table>

<div class="section-title">2. Expiry Date-by-Date Target Attainment Matrix (1:1 / 1:2 / 1:3 Status)</div>
<table>
  <thead>
    <tr>
      <th>Expiry Date</th>
      <th>ATM (1:1 / 1:2 / 1:3)</th>
      <th>OTM (1:1 / 1:2 / 1:3)</th>
      <th>ITM (1:1 / 1:2 / 1:3)</th>
      <th>ANY Attained</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>2026-08-04</td>
      <td>T / F / F</td>
      <td>F / F / F</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-08-11</td>
      <td>T / F / F</td>
      <td>T / F / F</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-08-18</td>
      <td>T / T / T</td>
      <td>F / F / F</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-08-25</td>
      <td>F / F / F</td>
      <td>T / T / T</td>
      <td>T / F / F</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-09-01</td>
      <td>T / T / T</td>
      <td>T / T / F</td>
      <td>T / F / F</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-09-08</td>
      <td>T / T / T</td>
      <td>T / F / F</td>
      <td>T / T / T</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-09-15</td>
      <td>F / F / F</td>
      <td>T / T / T</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-09-22</td>
      <td>F / F / F</td>
      <td>T / F / F</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-09-29</td>
      <td>T / F / F</td>
      <td>F / F / F</td>
      <td>T / T / T</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-10-06</td>
      <td>T / F / F</td>
      <td>T / T / T</td>
      <td>F / F / F</td>
      <td class="true-bg">True</td>
    </tr>
    <tr>
      <td>2026-10-13</td>
      <td>F / F / F</td>
      <td>T / T / F</td>
      <td>No Trade</td>
      <td class="true-bg">True</td>
    </tr>
  </tbody>
</table>
</body>
</html>