<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Calibri, sans-serif; font-size: 11pt; }
  table { border-collapse: collapse; width: 100%; margin-top: 10px; }
  th { background-color: #1f4e78; color: white; padding: 10px; border: 1px solid #b0c4de; text-align: center; font-size: 11pt; }
  td { padding: 8px 12px; border: 1px solid #d3d3d3; text-align: center; }
  tr:nth-child(even) { background-color: #f9f9f9; }
  .profit-bg { background-color: #d4edda !important; color: #155724 !important; font-weight: bold; }
  .loss-bg { background-color: #f8d7da !important; color: #721c24 !important; font-weight: bold; }
  .profit-text { color: #28a745; font-weight: bold; }
  .loss-text { color: #dc3545; font-weight: bold; }
  .title { font-size: 16pt; font-weight: bold; color: #1f4e78; margin-bottom: 10px; }
</style>
</head>
<body>
<div class="title">📊 ATM-Only Expiry Strategy Backtest Results</div>
<table>
  <thead>
    <tr>
      <th>Expiry Date</th>
      <th>Entry Time</th>
      <th>Meet / Exit Time</th>
      <th>Symbol</th>
      <th>Strike Price</th>
      <th>Entry Price (₹)</th>
      <th>Closing Price (₹)</th>
      <th>Quantity</th>
      <th>Result</th>
      <th>PnL Amount (₹)</th>
      <th>Exit Reason</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>2026-08-11</td>
      <td>2026-08-11 15:20:00</td>
      <td>2026-08-11 15:30:00</td>
      <td>NIFTY</td>
      <td>24450 PE (ATM)</td>
      <td>₹4.00</td>
      <td>₹0.05</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹256.75)</td>
      <td class="loss-bg">-₹256.75</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
    <tr>
      <td>2026-08-18</td>
      <td>2026-08-18 15:15:00</td>
      <td>2026-08-18 15:30:00</td>
      <td>NIFTY</td>
      <td>24150 PE (ATM)</td>
      <td>₹3.95</td>
      <td>₹0.05</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹253.50)</td>
      <td class="loss-bg">-₹253.50</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
    <tr>
      <td>2026-09-01</td>
      <td>2026-09-01 15:25:00</td>
      <td>2026-09-01 15:30:00</td>
      <td>NIFTY</td>
      <td>24050 CE (ATM)</td>
      <td>₹5.95</td>
      <td>₹5.75</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹13.00)</td>
      <td class="loss-bg">-₹13.00</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
    <tr>
      <td>2026-09-22</td>
      <td>2026-09-22 15:20:00</td>
      <td>2026-09-22 15:30:00</td>
      <td>NIFTY</td>
      <td>23350 CE (ATM)</td>
      <td>₹6.25</td>
      <td>₹0.05</td>
      <td>65</td>
      <td class="loss-bg">LOSS (-₹403.00)</td>
      <td class="loss-bg">-₹403.00</td>
      <td>MARKET_CLOSE_TIME</td>
    </tr>
  </tbody>
</table>
</body>
</html>